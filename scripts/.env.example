# ==============================
# Notion 設定
# ==============================
# 從 https://www.notion.so/my-integrations 建立 Integration 取得
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion 資料庫 ID（從資料庫頁面 URL 取得）
# URL 格式：https://www.notion.so/{workspace}/{DATABASE_ID}?v=xxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==============================
# Anthropic / Claude API 設定
# ==============================
# 從 https://console.anthropic.com/keys 取得
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==============================
# Google 設定
# ==============================
# Google Drive 目標資料夾 ID（從 Drive 資料夾 URL 取得）
# URL 格式：https://drive.google.com/drive/folders/{FOLDER_ID}
# 留空或填 "root" 表示儲存在根目錄
GOOGLE_DRIVE_FOLDER_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google OAuth 憑證檔案路徑（從 Google Cloud Console 下載）
GOOGLE_CREDENTIALS_FILE=credentials.json

# Google OAuth Token 儲存路徑（首次執行後自動產生）
GOOGLE_TOKEN_FILE=token.json

# ==============================
# 通知設定
# ==============================
# 收件人 Email
RECIPIENT_EMAIL=ccl0320@gmail.com

# ==============================
# 工作流程設定
# ==============================
# 持續監聽模式的檢查間隔（秒），預設 300 秒（5分鐘）
WATCH_INTERVAL_SECONDS=300

# 已處理的頁面 ID 紀錄檔案
PROCESSED_IDS_FILE=.processed_ids.json
